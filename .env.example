# Variáveis do processo; .env não é carregado automaticamente.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# Preencher ativa entrada /entrar para qualquer pessoa na conversa privada (senha fora do Git).
# Manter o ID anterior acima para preservar seu banco legado; ele deixa de ser uma exceção à senha.
TELEGRAM_ACCESS_PASSWORD=
# Limite técnico de sessões de 24 h; não é limite de gasto do modelo.
TELEGRAM_ACCESS_MAX_USERS=100
TELEGRAM_STATE_DIR=data
# URL da API; HTTP permitido somente para loopback, ex.: http://localhost:8000.
BACKEND_BASE_URL=
# Mesmo valor de BOT_API_TOKEN no api-backend (>=32 caracteres). Não é token Telegram.
BACKEND_API_TOKEN=
# BOT-01: manter false até processador AI-02, volume e ensaio integrado estarem prontos.
TELEGRAM_CONVERSATION_ENABLED=false
# CART-01: canal humano separado; manter false até contrato INT-02 e ensaio controlado.
# Exige a conversa acima e a API com CART-01; não libera pedido ou pagamento.
TELEGRAM_CART_ENABLED=false
